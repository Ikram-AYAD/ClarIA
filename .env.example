# Copie ce fichier en ".env" et renseigne tes cles API (toutes deux gratuites).

# Generation des reponses. Obtiens une cle sur : https://console.groq.com/keys
GROQ_API_KEY=gsk_votre_cle_api_ici

# Calcul des embeddings via l'API d'inference Hugging Face (pas de modele
# lourd installe/charge en local). Obtiens un token "fine-grained" avec la
# permission "Inference Providers" sur :
# https://huggingface.co/settings/tokens/new?ownUserPermissions=inference.serverless.write&tokenType=fineGrained
HF_TOKEN=hf_votre_token_ici
